  238          marginTop: '0.5rem',

  241        }}>
  242:         💡 <strong>Competition Photo Tips:</strong>
  243:         <ul style={{ marginTop: '0.25rem', marginLeft: '1.5rem', lineHeight: '1.4' }}>
  244:           <li>Place fish snout against measuring board stop</li>
  245:           <li>Show tail end on ruler</li>
  246:           <li>Include ID bracelet on wrist</li>
  247:           <li>Ensure species clearly visible</li>
  248:           <li>Multiple attempts OK if boat moving</li>
  249:         </ul>
  250:       </div>
  251:     </div>
  252    )

